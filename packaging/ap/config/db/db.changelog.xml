  <!--
    Creates the initial admin user only if one does not already exist.
    This changeSet is executed during the first-time setup.
  -->
  <changeSet author="harmony" id="default-admin-user" runOrder="last">
    <!--
      Accepts any checksum because the admin password is dynamically generated at runtime
      using a salted hash. This results in a different value on each container startup.
      The changeSet is executed only once and is guarded by preconditions to prevent duplicate
      creation if an admin user already exists.
    -->
    <validCheckSum>ANY</validCheckSum>
    <preConditions onFail="MARK_RAN" onError="MARK_RAN">
      <tableExists tableName="TB_USER"/>
      <tableExists tableName="TB_USER_ROLES"/>
      <tableExists tableName="TB_USER_ROLE"/>

      <sqlCheck expectedResult="0">
        SELECT COUNT(*)
        FROM TB_USER U
          JOIN TB_USER_ROLES URS ON U.ID_PK = URS.USER_ID
          JOIN TB_USER_ROLE UR ON URS.ROLE_ID = UR.ID_PK
        WHERE UR.ROLE_NAME = 'ROLE_ADMIN'
      </sqlCheck>
    </preConditions>

    <insert tableName="TB_USER">
      <column name="ID_PK"            value="197001010000000001"/>
      <column name="USER_NAME"        value="${admin.user}"/>
      <column name="USER_PASSWORD"    value="${admin.pass.hash}"/>
      <column name="USER_ENABLED"     valueNumeric="1"/>
      <column name="USER_DELETED"     valueNumeric="0"/>
      <column name="DEFAULT_PASSWORD" valueNumeric="0"/>
    </insert>

    <insert tableName="TB_USER_ROLES">
      <column name="USER_ID"  value="197001010000000001"/>
      <column name="ROLE_ID"  value="197001010000000001"/>
    </insert>
  </changeSet>

</databaseChangeLog>
