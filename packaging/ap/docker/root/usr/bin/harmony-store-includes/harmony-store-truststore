#!/bin/bash
set -euo pipefail

if ! declare -f log >/dev/null; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  source "$SCRIPT_DIR/harmony-store-common"
fi

import_certificate_to_truststore() {
  local -n import_certificate_config="$1"
  validate_required_keys import_certificate_config alias public_cert_path store_path store_password store_type

  local alias="${import_certificate_config[alias]}"
  local public_cert_path="${import_certificate_config[public_cert_path]}"
  local store_path="${import_certificate_config[store_path]}"
  local store_password="${import_certificate_config[store_password]}"
  local store_type="${import_certificate_config[store_type]}"

  local output
  output=$(keytool \
    -storetype "$store_type" \
    -import \
    -noprompt \
    -alias "$alias" \
    -keystore "$store_path" \
    -storepass "$store_password" \
    -file "$public_cert_path" \
    2>&1)
  local exit_code=$?

  if [[ $exit_code -ne 0 ]]; then
    log ERROR "Failed to import certificate into truststore '$store_path': $output"
  else
    log DEBUG "Certificate imported into truststore. [store=$store_path]"
  fi

  return $exit_code
}

delete_certificate_from_truststore() {
  local -n delete_certificate_config="$1"
  validate_required_keys delete_certificate_config alias store_path store_password store_type

  local alias="${delete_certificate_config[alias]}"
  local store_path="${delete_certificate_config[store_path]}"
  local store_password="${delete_certificate_config[store_password]}"
  local store_type="${delete_certificate_config[store_type]}"

  local output
  output=$(keytool \
    -storetype "$store_type" \
    -delete \
    -alias "$alias" \
    -keystore "$store_path" \
    -storepass "$store_password" 2>&1)
  local exit_code=$?

  if [[ $exit_code -ne 0 ]]; then
    log ERROR "Failed to delete alias '$alias' in truststore '$store_path': $output"
  else
    log DEBUG "Alias '$alias' deleted from truststore. [store=$store_path]"
  fi

  return $exit_code
}

create_new_truststore() {
  local -n new_truststore_config="$1"
  validate_required_keys new_truststore_config alias store_path public_cert_path should_add_certificate_to_truststore

  local alias="${new_truststore_config[alias]}"
  local store_path="${new_truststore_config[store_path]}"
  local public_cert_path="${new_truststore_config[public_cert_path]}"
  local should_add_certificate_to_truststore="${new_truststore_config[should_add_certificate_to_truststore]}"

  temp_cert=""

  cleanup_temp_cert() {
    if [[ -n "$temp_cert" && -f "$temp_cert" ]]; then
      rm -f "$temp_cert"
      log DEBUG "Temporary certificate file '$temp_cert' removed"
    fi
  }
  trap cleanup_temp_cert EXIT

  if [[ "$should_add_certificate_to_truststore" == "true" ]]; then
    import_certificate_to_truststore new_truststore_config
  else
    temp_cert="$(mktemp)"
    local dummy_alias="dummy"

    if openssl req -x509 -newkey rsa:2048 -keyout /dev/null -nodes \
      -out "$temp_cert" -days 1 -subj "/CN=$dummy_alias" >/dev/null 2>&1; then

      new_truststore_config[alias]="$dummy_alias"
      new_truststore_config[public_cert_path]="$temp_cert"

      import_certificate_to_truststore new_truststore_config

      delete_certificate_from_truststore new_truststore_config

      log INFO "Empty truststore created. [store=$store_path]"
    else
      die "Failed to create empty truststore. [store=$store_path]"
    fi
  fi
}

import_public_certificate_if_needed() {
  local -n import_certificate_if_needed_config="$1"
  validate_required_keys import_certificate_if_needed_config alias store_path should_add_certificate_to_truststore

  local alias="${import_certificate_if_needed_config[alias]}"
  local store_path="${import_certificate_if_needed_config[store_path]}"
  local should_add_certificate_to_truststore="${import_certificate_if_needed_config[should_add_certificate_to_truststore]}"

  if [[ "$should_add_certificate_to_truststore" == "true" ]]; then
    if alias_exists_in_store import_certificate_if_needed_config; then
      if validate_certificate_in_store import_certificate_if_needed_config; then
        log DEBUG "Certificate for alias '$alias' already exists and is valid. Import skipped. [store=$store_path]"
      else
        log WARN "Certificate for alias '$alias' is invalid or mismatched. It will be reimported. [store=$store_path]"
        delete_certificate_from_truststore import_certificate_if_needed_config
        import_certificate_to_truststore import_certificate_if_needed_config
      fi
    else
      log INFO "Alias '$alias' not found in truststore. Importing certificate. [store=$store_path]"
      import_certificate_to_truststore import_certificate_if_needed_config
    fi
  fi
}

process_truststore() {
  local -n truststore_config="$1"
  validate_required_keys truststore_config store_path store_password store_base64

  local store_path="${truststore_config[store_path]}"
  local store_password="${truststore_config[store_password]}"
  local store_base64="${truststore_config[store_base64]}"

  if [[ -f "$store_path" ]]; then
    log INFO "Truststore already exists. Validating. [store=$store_path]"
  else
    if [[ -n "$store_base64" ]]; then
      log INFO "No truststore found. Loading from base64. [store=$store_path]"
      load_store_from_base64 truststore_config
    else
      log INFO "No truststore found and no base64 provided. Creating new truststore. [store=$store_path]"
      create_new_truststore truststore_config
    fi
  fi

  # After existence or creation, validate the truststore
  validate_store_file_and_password truststore_config

  # Load the public certificate into the truststore
  import_public_certificate_if_needed truststore_config
}
