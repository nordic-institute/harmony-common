#!/bin/bash
set -euo pipefail

if ! declare -f log >/dev/null; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  source "$SCRIPT_DIR/harmony-store-common"
fi

create_new_keystore() {
  local -n new_keystore_config="$1"

  validate_required_keys new_keystore_config alias store_path store_password dname san store_type

  local alias="${new_keystore_config[alias]}"
  local store_path="${new_keystore_config[store_path]}"
  local store_password="${new_keystore_config[store_password]}"
  local dname="${new_keystore_config[dname]}"
  local san="${new_keystore_config[san]}"
  local store_type="${new_keystore_config[store_type]}"

  local san_arg=()
  if [[ -n "$san" ]]; then
      san_arg=(-ext "SAN=$san")
  fi

  output=$(
    keytool \
      -storetype "$store_type" \
      -genkeypair \
      -keyalg RSA \
      -alias "$alias" \
      -keystore "$store_path" \
      -storepass "$store_password" \
      -validity 333 \
      -keysize 3072 \
      -dname "$dname" \
      "${san_arg[@]}" \
      2>&1
  )
  local exit_code=$?

  if [[ $exit_code -ne 0 ]]; then
    log "ERROR" "Error creating new keystore at path '$store_path': $output"
  else
    log "DEBUG" "Keystore created with alias '$alias'. [store=$store_path]"
  fi

  return $exit_code
}

export_public_certificate() {
  local -n export_certificate_config="$1"

  validate_required_keys export_certificate_config alias store_path store_password public_cert_path

  local alias="${export_certificate_config[alias]}"
  local store_path="${export_certificate_config[store_path]}"
  local store_password="${export_certificate_config[store_password]}"
  local public_cert_path="${export_certificate_config[public_cert_path]}"

  local output
  output=$(keytool \
    -export \
    -alias "$alias" \
    -keystore "$store_path" \
    -storepass "$store_password" \
    -file "$public_cert_path" \
    2>&1)
  local exit_code=$?

  if [[ $exit_code -ne 0 ]]; then
    log "ERROR" "Failed to export certificate from keystore at '$store_path': $output"
  else
    log "DEBUG" "Certificate exported to '$public_cert_path' [store=$store_path]"
  fi

  return $exit_code
}

export_public_certificate_if_needed() {
  local -n export_certificate_if_needed="$1"

  validate_required_keys export_certificate_if_needed public_cert_path alias store_path

  local public_cert_path="${export_certificate_if_needed[public_cert_path]}"
  local store_path="${export_certificate_if_needed[store_path]}"

  if [[ -f "$public_cert_path" ]]; then
    if validate_certificate_in_store export_certificate_if_needed; then
      log "INFO" "Certificate at '$public_cert_path' matches the keystore. Export skipped. [store=$store_path]"
    else
      log "WARN" "Certificate at '$public_cert_path' does not match the keystore. Certificate will be re-exported. [store=$store_path]"
      export_public_certificate export_certificate_if_needed
    fi
  else
    export_public_certificate export_certificate_if_needed
  fi
}

process_keystore() {
  local -n keystore_config="$1"
  validate_required_keys keystore_config store_path store_password store_base64

  local store_path="${keystore_config[store_path]}"
  local store_password="${keystore_config[store_password]}"
  local store_base64="${keystore_config[store_base64]}"

  if [[ -f "$store_path" ]]; then
    log "INFO" "Keystore already exists. Validating. [store=$store_path]"
  else
    if [[ -n "$store_base64" ]]; then
      log "INFO" "No keystore found. Loading from base64. [store=$store_path]"
      load_store_from_base64 keystore_config
    else
      log "INFO" "No keystore found and no base64 provided. Creating new keystore. [store=$store_path]"
      create_new_keystore keystore_config
    fi
  fi

  # After existence or creation, validate the keystore
  validate_store_file_and_password keystore_config

  # Verify if the alias exists in the keystore; it might be missing if a different alias is used from a previous run
  if ! alias_exists_in_store keystore_config; then
    log "INFO" "Alias '${keystore_config[alias]}' not found in keystore. Creating new keypair. [store=$store_path]"
    create_new_keystore keystore_config
  else
    log "DEBUG" "Alias '${keystore_config[alias]}' exists in keystore. [store=$store_path]"
  fi

  # Export certificate
  export_public_certificate_if_needed keystore_config
}