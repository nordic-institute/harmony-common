#!/bin/bash
set -euo pipefail

source /usr/lib/harmony-common

readonly DEFAULT_CHARSET='A-Za-z0-9~`!@#$%^&*()_+={[}]|;:,.<>?/-'

parse_cli_args() {
  local -n _charset_ref=$1
  shift 1

  _charset_ref=$DEFAULT_CHARSET

  # shellcheck disable=SC2034 # Used in sourced scripts
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage|-s)   STAGE="${2:+$2-}pwdcli";  shift 2 ;;
      --charset|-c) _charset_ref="$2";        shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
}

generate_password() {
  local charset="$1"

  local length=24
  local password_parts=""

  local lower='a-z'
  local upper='A-Z'
  local digit='0-9'
  local special='~`!@#$%^&*()_+={[}]|;:,.<>?/-'

  password_parts+=$(tr -dc "$lower" < /dev/urandom | head -c 1)
  password_parts+=$(tr -dc "$upper" < /dev/urandom | head -c 1)
  password_parts+=$(tr -dc "$digit" < /dev/urandom | head -c 1)
  password_parts+=$(tr -dc "$special" < /dev/urandom | head -c 1)

  local remaining_len=$((length - ${#password_parts}))
  if (( remaining_len > 0 )); then
    password_parts+=$(tr -dc "$charset" < /dev/urandom | head -c "$remaining_len")
  fi

  local final_password
  final_password=$(echo "$password_parts" | fold -w1 | shuf | tr -d '\n')

  log INFO "Password generated successfully."

  echo "$final_password"
  return 0
}

main() {
  local charset

  parse_cli_args charset "$@"

  if ! result=$(generate_password "$charset"); then
    die "Password generation failed."
  fi

  echo "$result"
  exit 0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
