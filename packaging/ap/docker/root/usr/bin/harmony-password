#!/bin/bash
set -euo pipefail

source /usr/lib/harmony-common

parse_cli_args() {
  # shellcheck disable=SC2034 # Used in sourced scripts
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage|-s)             STAGE="${2:+$2-}pwdcli";  shift 2 ;;
      --mode|-m)              MODE="$2";            shift 2 ;;
      --password-value|-p)    PASSWORD_VALUE="$2";  shift 2 ;;
      --current-password|-c)  CURRENT_PASSWORD="$2"; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
}

validate_cli_args() {
  if [[ -z "$MODE" ]]; then
    die "Missing required argument: --mode"
  fi
}

generate_password() {
  local password=""
  local charset='A-Za-z0-9~`!@#$%^&*()_+={[}]|;:,.<>?/-'
  local attempt=0
  local max_attempts=100

  while (( attempt < max_attempts )); do
    ((attempt++))

    password=$(openssl rand -base64 48 | tr -d '\n' | tr -dc "$charset" | head -c 24)

    if [[ ${#password} -ge 16 ]] &&
       [[ "$password" =~ [a-z] ]] &&
       [[ "$password" =~ [A-Z] ]] &&
       [[ "$password" =~ [0-9] ]] &&
       [[ "$password" =~ [^a-zA-Z0-9] ]]; then
      log INFO "Password generated successfully."
      echo "$password"
      return 0
    fi
  done

  log ERROR "Could not generate a valid password after $max_attempts attempts."
  return 1
}

determine_password() {
  local password_value="$1"
  local current_password="$2"
  local final_password=""

  if [[ -n "$password_value" ]]; then
    log DEBUG "Provided password will be used."
    final_password="$password_value"
  elif [[ -n "$current_password" ]]; then
    log DEBUG "Existing password will be used."
    final_password="$current_password"
  else
    log INFO "No existing password provided. A new password will be generated."
    if ! final_password=$(generate_password); then
      die "Password generation failed in determine_password."
    fi
  fi

  echo "$final_password"
}

run_mode() {
  local -n result_ref=$1

  # shellcheck disable=SC2034 # result_ref is a nameref
  case "$MODE" in
    generate)   result_ref=$(generate_password) ;;
    determine)  result_ref=$(determine_password "$PASSWORD_VALUE" "$CURRENT_PASSWORD") ;;
    *) die "Unsupported --mode value: $MODE. Use 'generate' or 'determine'." ;;
  esac

  log DEBUG "Password processing completed"
}

main() {
  parse_cli_args "$@"
  validate_cli_args

  local result
  run_mode result

  echo "$result"
  exit 0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
