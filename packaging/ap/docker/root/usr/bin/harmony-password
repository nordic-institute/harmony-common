#!/bin/bash
set -euo pipefail

source /usr/lib/harmony-common

readonly DEFAULT_CHARSET='A-Za-z0-9~`!@#$%^&*()_+={[}]|;:,.<>?/-'
readonly DEFAULT_MAX_ATTEMPTS=100

parse_cli_args() {
  local -n _charset_ref=$1
  local -n _max_attempts_ref=$2
  shift 2

  _charset_ref=$DEFAULT_CHARSET
  _max_attempts_ref=$DEFAULT_MAX_ATTEMPTS

  # shellcheck disable=SC2034 # Used in sourced scripts
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage|-s)         STAGE="${2:+$2-}pwdcli";  shift 2 ;;
      --charset|-c)       _charset_ref="$2";        shift 2 ;;
      --max-attempts|-m)  _max_attempts_ref="$2";   shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
}

generate_password() {
  local charset="$1"
  local max_attempts="$2"
  local password=""

  for (( attempt=1; attempt<=max_attempts; attempt++ )); do
    password=$(openssl rand -base64 48 | tr -d '\n' | tr -dc "$charset" | head -c 24)

    if [[ ${#password} -ge 16 ]] &&
       [[ "$password" =~ [a-z] ]] &&
       [[ "$password" =~ [A-Z] ]] &&
       [[ "$password" =~ [0-9] ]] &&
       [[ "$password" =~ [^a-zA-Z0-9] ]]; then
      log INFO "Password generated successfully."
      echo "$password"
      return 0
    fi
  done

  log ERROR "Could not generate a valid password after $max_attempts attempts."
  return 1
}

main() {
  local charset max_attempts

  parse_cli_args charset max_attempts "$@"

  if ! result=$(generate_password "$charset" "$max_attempts"); then
    die "Password generation failed."
  fi

  echo "$result"
  exit 0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
