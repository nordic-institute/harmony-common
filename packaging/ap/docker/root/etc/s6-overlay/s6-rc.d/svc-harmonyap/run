#!/command/execlineb -S0
with-contenv

importas -D 512m MAX_MEM MAX_MEM
importas -u WORK_LOCATION WORK_LOCATION
importas -u CATALINA_TEMP_DIR CATALINA_TEMP_DIR
importas -u HARMONY_BASE HARMONY_BASE
importas -u HARMONY_HOME HARMONY_HOME
importas -u TLS_TRUSTSTORE_PATH TLS_TRUSTSTORE_PATH
importas -u TLS_TRUSTSTORE_PASSWORD TLS_TRUSTSTORE_PASSWORD
importas -u LOGBACK_CONFIG_FILE LOGBACK_CONFIG_FILE
importas -u NODE_ID NODE_ID
importas -u PRESERVE_BACKUP_FILE_DATE PRESERVE_BACKUP_FILE_DATE

exec java \
  -Xms256m -Xmx"$MAX_MEM" \
  -XX:+UseParallelGC \
  -XX:+ExitOnOutOfMemoryError \
  -XX:MaxMetaspaceSize=256m \
  --add-opens=java.base/java.lang=ALL-UNNAMED \
  --add-opens=java.base/java.io=ALL-UNNAMED \
  --add-opens=java.base/java.util=ALL-UNNAMED \
  --add-opens=java.base/java.util.concurrent=ALL-UNNAMED \
  --add-opens=java.rmi/sun.rmi.transport=ALL-UNNAMED \
  --add-opens=java.base/java.nio=ALL-UNNAMED \
  --add-opens=java.base/sun.nio.ch=ALL-UNNAMED \
  --add-opens=java.management/sun.management=ALL-UNNAMED \
  --add-opens=jdk.management/com.sun.management.internal=ALL-UNNAMED \
  --add-exports=java.base/jdk.internal.ref=ALL-UNNAMED \
  -Djava.awt.headless=true \
  -Djava.io.tmpdir="${CATALINA_TMPDIR}" \
  -Djava.rmi.server.hostname=127.0.0.1 \
  -Djava.security.egd=file:/dev/urandom \
  -Djava.util.logging.config.file="${HARMONY_BASE}/conf/logging.properties" \
  -Djava.util.logging.manager=org.apache.juli.ClassLoaderLogManager \
  -Djavax.net.ssl.trustStore="${TLS_TRUSTSTORE_PATH}" \
  -Djavax.net.ssl.trustStorePassword="${TLS_TRUSTSTORE_PASSWORD}" \
  -Dlogback.configurationFile="${LOGBACK_CONFIG_FILE}" \
  -Dcatalina.base="${HARMONY_BASE}" \
  -Dcatalina.home="${HARMONY_HOME}" \
  -Ddomibus.config.location="${HARMONY_BASE}/etc" \
  -Ddomibus.work.location="${WORK_LOCATION}" \
  -Ddomibus.extensions.location="${HARMONY_HOME}" \
  -Ddomibus.node.id="${NODE_ID}" \
  -Ddomibus.backup.preserveFileDate="${PRESERVE_BACKUP_FILE_DATE}" \
  -classpath "${HARMONY_HOME}/bin/bootstrap.jar:${HARMONY_HOME}/bin/tomcat-juli.jar" \
  org.apache.catalina.startup.Bootstrap