<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <!-- pattern definition -->
    <conversionRule conversionWord="domibusLine" converterClass="eu.domibus.logging.DomibusLineOfCallerConverter"/>
    <property name="encoderPattern"
              value="%d{ISO8601} [%X{d_user}] [%X{d_domain}] [%X{d_messageId}] [%X{d_messageEntityId}] [%thread] %5p %c{1}:%domibusLine - %m%n"
              scope="global"/>
    <property name="statisticsPattern" value="%d{ISO8601} %5p %c{1}:%domibusLine - %m%n" scope="global"/>

    <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${encoderPattern}</pattern>
        </encoder>
    </appender>

    <appender name="statistic" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${statisticsPattern}</pattern>
        </encoder>
    </appender>

    <appender name="logstash" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>logstash:5014</destination>

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</pattern>
                </timestamp>
                <logLevel fieldName="level"/>
                <threadName fieldName="thread"/>
                <loggerName fieldName="logger" shortenedLoggerNameLength="1"/>
                <pattern>
                    <pattern>
                        { "line": "%domibusLine" }
                    </pattern>
                </pattern>

                <mdc>
                    <includeMdcKeyName>d_user</includeMdcKeyName>
                    <includeMdcKeyName>d_domain</includeMdcKeyName>
                    <includeMdcKeyName>d_messageId</includeMdcKeyName>
                    <includeMdcKeyName>d_messageEntityId</includeMdcKeyName>
                </mdc>

                <message/>
                <stackTrace fieldName="exception"/>
            </providers>
        </encoder>
    </appender>

    <logger name="eu.domibus" level="INFO">
        <appender-ref ref="logstash"/>
    </logger>

    <logger name="eu.domibus.statistic" level="INFO" additivity="false">
        <appender-ref ref="statistic"/>
    </logger>

    <!--  In order to enable logging of request/responses please change the loglevel to INFO -->
    <logger name="org.apache.cxf" level="WARN">
        <appender-ref ref="stdout"/>
        <appender-ref ref="logstash"/>
    </logger>

    <root level="WARN">
        <appender-ref ref="stdout"/>
        <appender-ref ref="logstash"/>
    </root>

</configuration>
