<?xml version="1.0" encoding="UTF-8"?>

<Server port="-1" shutdown="SHUTDOWN">
    <Listener className="org.apache.catalina.startup.VersionLoggerListener" logArgs="false"/>
    <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener"/>
    <Listener className="org.apache.catalina.mbeans.GlobalResourcesLifecycleListener"/>
    <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener"/>

    <Service name="Catalina">

        <Connector SSLEnabled="${TOMCAT_SSL_ENABLED}"
                   protocol="org.apache.coyote.http11.Http11NioProtocol"
                   port="${TOMCAT_PORT}"
                   maxThreads="200"
                   scheme="${TOMCAT_SCHEME}"
                   secure="${TOMCAT_SECURE}"
                   keystoreFile="${TLS_KEYSTORE_PATH}"
                   keystorePass="${TLS_KEYSTORE_PASSWORD}"
                   keystoreType="${TLS_KEYSTORE_TYPE}"
                   keyAlias="${TLS_KEY_ALIAS}"
                   truststoreFile="${TLS_TRUSTSTORE_PATH}"
                   truststorePass="${TLS_TRUSTSTORE_PASSWORD}"
                   truststoreType="${TLS_TRUSTSTORE_TYPE}"
                   clientAuth="want"
                   sslProtocol="TLS"
        />

        <Engine name="Catalina" defaultHost="localhost">

            <Host name="localhost"
                  appBase="/usr/lib/harmony-ap/webapps"
                  createDirs="false"
                  unpackWARs="false"
                  autoDeploy="false"
                  workDir="${TOMCAT_WORK_DIR}">

                <Valve className="org.apache.catalina.valves.ErrorReportValve"
                       showReport="false"
                       showServerInfo="false"
                />

                <Valve className="org.apache.catalina.valves.AccessLogValve"
                       directory="${TOMCAT_ACCESS_LOG_DIR}"
                       prefix="localhost_access_log" suffix=".txt"
                       pattern="%h %l %u %t &quot;%r&quot; %s %b"
                       maxDays="90"
                />

                <Context path="">
                    <Manager pathname=""/>
                    <JarScanner>
                        <JarScanFilter defaultTldScan="false"/>
                    </JarScanner>
                </Context>

            </Host>
        </Engine>
    </Service>
</Server>
