#!/command/with-contenv bash
set -euo pipefail

# shellcheck disable=SC2034 # Used in sourced scripts
readonly STAGE="init-end"

source /usr/lib/harmony-ap/lib/harmony-common
source /usr/lib/harmony-ap/lib/harmony-cluster

declare -A TRANSLATIONS=(
  # Database
  [DB_URL]=DOMIBUS_DATASOURCE_URL
  [DB_DRIVER_CLASS]=DOMIBUS_DATASOURCE_DRIVERCLASSNAME
  [DB_HIBERNATE_DIALECT]=DOMIBUS_HIBERNATE_DIALECT
  [DB_SCHEMA]=DOMIBUS_DATABASE_SCHEMA
  [DB_HOST]=DOMIBUS_DATABASE_SERVERNAME
  [DB_PORT]=DOMIBUS_DATABASE_PORT
  [DB_USER]=DOMIBUS_DATASOURCE_USER
  [DB_PASSWORD]=DOMIBUS_DATASOURCE_PASSWORD

  # Domibus
  [DEPLOYMENT_CLUSTERED]=DOMIBUS_DEPLOYMENT_CLUSTERED
  [CERT_ALIAS]=DOMIBUS_SECURITY_KEY_PRIVATE_ALIAS
  [SECURITY_KEYSTORE_PASSWORD]=DOMIBUS_SECURITY_KEYSTORE_PASSWORD
  [SECURITY_TRUSTSTORE_PASSWORD]=DOMIBUS_SECURITY_TRUSTSTORE_PASSWORD
  [SECURITY_KEY_PRIVATE_PASSWORD]=DOMIBUS_SECURITY_KEY_PRIVATE_PASSWORD
  [SECURITY_KEYSTORE_PATH]=DOMIBUS_SECURITY_KEYSTORE_LOCATION
  [SECURITY_KEYSTORE_TYPE]=DOMIBUS_SECURITY_KEYSTORE_TYPE
  [SECURITY_TRUSTSTORE_PATH]=DOMIBUS_SECURITY_TRUSTSTORE_LOCATION
  [SECURITY_TRUSTSTORE_TYPE]=DOMIBUS_SECURITY_TRUSTSTORE_TYPE
  [PRESERVE_BACKUP_FILE_DATE]=DOMIBUS_BACKUP_PRESERVEFILEDATE
  [SML_ZONE]=DOMIBUS_SMLZONE
  [USE_DYNAMIC_DISCOVERY]=DOMIBUS_DYNAMICDISCOVERY_USEDYNAMICDISCOVERY
  [UI_SESSION_SECURE]=DOMIBUS_UI_SESSION_SECURE

  # Tomcat
  [SSL_ENABLED]=TOMCAT_SSL_ENABLED
  [SERVER_PORT]=TOMCAT_PORT
  [LOG_DIR]=TOMCAT_ACCESS_LOG_DIR
)

translate_env() {
  local s6_env="/var/run/s6/container_environment"

  local src dst
  for src in "${!TRANSLATIONS[@]}"; do
    dst="${TRANSLATIONS[$src]}"
    if [[ -f "$s6_env/$src" ]]; then
      cp "$s6_env/$src" "$s6_env/$dst"
      log DEBUG "Translated: $src -> $dst"
    fi
  done
}

log DEBUG "Started"

translate_env

if is_primary; then
  set_ready_flag
else
  publish_env REPLICA_STATE "ready"
fi

echo "$HARMONY_VERSION" > "${HARMONY_BASE}/.version"

log DEBUG "Done"