#!/command/with-contenv bash
set -euo pipefail

readonly STAGE="config-database"

source /usr/lib/harmony-ap/lib/harmony-common

: "${DB_USER:=harmony_ap}"
: "${DB_SCHEMA:=harmony_ap}"
: "${DB_TYPE:=mysql}"
: "${DB_PORT:=3306}"

get_database_connection_details() {
  local user password
  user="$DB_USER"
  password="${DB_PASSWORD:-}"

  if [[ -z "$password" ]]; then
    die "Database password (DB_PASSWORD) is required. Exiting."
  fi

  local url driver dialect host port schema
  read -r url driver dialect host port schema < <(
    harmony-database \
      --mode get-connection-details \
      --stage "$STAGE" \
      --db-type "$DB_TYPE" \
      --db-url "${DB_URL:-}" \
      --db-driver-class "${DB_DRIVER_CLASS:-}" \
      --db-host "${DB_HOST:-}" \
      --db-port "$DB_PORT" \
      --db-schema "$DB_SCHEMA"
  )

  printf '%s\n' "$user" "$password" "$url" "$driver" "$dialect" "$host" "$port" "$schema"
}

validate_database_parameters() {
  local host="$1" password="$2"

  if [[ -z "$host" || -z "$password" ]]; then
    die "Database host (DB_HOST) and password (DB_PASSWORD) are required. Exiting."
  fi
}

wait_for_database() {
  local host="$1" port="$2" user="$3" pass="$4"

  DB_PASSWORD="$pass" \
  harmony-database \
    --mode wait-for-db \
    --stage "$STAGE" \
    --db-host "$host" \
    --db-port "$port" \
    --db-user "$user"
}

publish_database_env() {
  local url="$1" driver="$2" dialect="$3" schema="$4" host="$5" port="$6" user="$7" pass="$8"

  publish_env DB_URL "$url"
  publish_env DB_DRIVER_CLASS "$driver"
  publish_env DB_HIBERNATE_DIALECT "$dialect"
  publish_env DB_SCHEMA "$schema"
  publish_env DB_HOST "$host"
  publish_env DB_PORT "$port"
  publish_env DB_USER "$user"
  publish_env DB_PASSWORD "$pass"
}

config_database() {
  log DEBUG "Started"

  local _db_output
  _db_output="$(get_database_connection_details)"

  local _db_vals
  readarray -t _db_vals <<< "$_db_output"

  DB_USER="${_db_vals[0]}"
  DB_PASSWORD="${_db_vals[1]}"
  DB_URL="${_db_vals[2]}"
  DB_DRIVER_CLASS="${_db_vals[3]}"
  DB_HIBERNATE_DIALECT="${_db_vals[4]}"
  DB_HOST="${_db_vals[5]}"
  DB_PORT="${_db_vals[6]}"
  DB_SCHEMA="${_db_vals[7]}"

  validate_database_parameters "$DB_HOST" "$DB_PASSWORD"
  wait_for_database "$DB_HOST" "$DB_PORT" "$DB_USER" "$DB_PASSWORD"
  publish_database_env "$DB_URL" "$DB_DRIVER_CLASS" "$DB_HIBERNATE_DIALECT" "$DB_SCHEMA" "$DB_HOST" "$DB_PORT" "$DB_USER" "$DB_PASSWORD"

  log DEBUG "Done"
}

config_database
