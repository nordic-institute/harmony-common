#!/command/with-contenv bash
set -euo pipefail
umask 0027

readonly STAGE="init-domibus"

source /usr/lib/harmony-ap/lib/harmony-common
source /usr/lib/harmony-ap/lib/harmony-cluster

: "${SECURITY_PUBLIC_CERT_NAME:=security}"
: "${SECURITY_PUBLIC_CERT_PATH:=${CERT_DIR}/$SECURITY_PUBLIC_CERT_NAME-$CERT_ALIAS.cer}"
: "${SECURITY_KEYSTORE_PATH:=${HARMONY_SECURITY}/ap-keystore.p12}"
: "${SECURITY_KEYSTORE_TYPE:=pkcs12}"
: "${SECURITY_KEYSTORE_B64:=}"
: "${SECURITY_TRUSTSTORE_PATH:=${HARMONY_SECURITY}/ap-truststore.p12}"
: "${SECURITY_TRUSTSTORE_B64:=}"
: "${SECURITY_TRUSTSTORE_TYPE:=pkcs12}"
: "${SECURITY_DNAME:=CN=$PARTY_NAME}"

: "${UI_SESSION_SECURE:=}"
: "${USE_DYNAMIC_DISCOVERY:=false}"
: "${SML_ZONE:=}"
: "${PRESERVE_BACKUP_FILE_DATE:=}"

load_security_stores_from_secrets() {
  if [ -z "$SECURITY_KEYSTORE_B64" ] && [ ! -f "$SECURITY_KEYSTORE_PATH" ]; then
    log DEBUG "Reading security keystore file from secret"
    read_secret "SECURITY-KEYSTORE-FILE" "$SECURITY_KEYSTORE_PATH" || true
  fi

  if [ -z "$SECURITY_TRUSTSTORE_B64" ] && [ ! -f "$SECURITY_TRUSTSTORE_PATH" ]; then
    log DEBUG "Reading security truststore file from secret"
    read_secret "SECURITY-TRUSTSTORE-FILE" "$SECURITY_TRUSTSTORE_PATH" || true
  fi
}

manage_security_certificates() {
  log DEBUG "Processing security certificates"

  # Determine current keystore and truststore passwords
  local keystore_current
  keystore_current=$(read_secret "SECURITY-KEYSTORE-PASSWORD" || true)
  local truststore_current
  truststore_current=$(read_secret "SECURITY-TRUSTSTORE-PASSWORD" || true)

  security_store_output=$(
    KEYSTORE_PASSWORD="${SECURITY_KEYSTORE_PASSWORD:-$keystore_current}" \
    TRUSTSTORE_PASSWORD="${SECURITY_TRUSTSTORE_PASSWORD:-$truststore_current}" \
    harmony-store \
      --stage "$STAGE" \
      --keystore-path "$SECURITY_KEYSTORE_PATH" \
      --keystore-base64 "$SECURITY_KEYSTORE_B64" \
      --keystore-type "$SECURITY_KEYSTORE_TYPE" \
      --truststore-path "$SECURITY_TRUSTSTORE_PATH" \
      --truststore-base64 "$SECURITY_TRUSTSTORE_B64" \
      --truststore-type "$SECURITY_TRUSTSTORE_TYPE" \
      --should-add-certificate-to-truststore "false" \
      --alias "$CERT_ALIAS" \
      --public-cert-path "$SECURITY_PUBLIC_CERT_PATH" \
      --dname "$SECURITY_DNAME" \
      --label "AP security"
  )

  declare -A security_vals=()
  while IFS= read -r line; do
    [[ "$line" == *=* ]] || continue
    security_vals["${line%%=*}"]="${line#*=}"
  done <<< "$security_store_output"

  SECURITY_KEYSTORE_PASSWORD="${security_vals[KEYSTORE_PASSWORD]}"
  SECURITY_KEYSTORE_GENERATED="${security_vals[KEYSTORE_GENERATED]}"
  SECURITY_KEYSTORE_PASSWORD_GENERATED="${security_vals[KEYSTORE_PASSWORD_GENERATED]}"
  SECURITY_TRUSTSTORE_PASSWORD="${security_vals[TRUSTSTORE_PASSWORD]}"
  SECURITY_TRUSTSTORE_GENERATED="${security_vals[TRUSTSTORE_GENERATED]}"
  SECURITY_TRUSTSTORE_PASSWORD_GENERATED="${security_vals[TRUSTSTORE_PASSWORD_GENERATED]}"

  if [[ -z "${SECURITY_KEY_PRIVATE_PASSWORD:-}" ]]; then
    SECURITY_KEY_PRIVATE_PASSWORD=$(read_secret "SECURITY-KEY-PRIVATE-PASSWORD" || true)
  fi
  SECURITY_KEY_PRIVATE_PASSWORD="${SECURITY_KEY_PRIVATE_PASSWORD:-$SECURITY_KEYSTORE_PASSWORD}"
}

store_secrets() {
  if [[ "$SECURITY_KEYSTORE_PASSWORD_GENERATED" == "true" ]]; then
    store_secret "SECURITY-KEYSTORE-PASSWORD" "$SECURITY_KEYSTORE_PASSWORD"
  fi

  if [[ "$SECURITY_TRUSTSTORE_PASSWORD_GENERATED" == "true" ]]; then
    store_secret "SECURITY-TRUSTSTORE-PASSWORD" "$SECURITY_TRUSTSTORE_PASSWORD"
  fi

  if [[ "$SECURITY_KEYSTORE_GENERATED" == "true" ]]; then
    store_secret "SECURITY-KEYSTORE-FILE" "$SECURITY_KEYSTORE_PATH"
  fi

  if [[ "$SECURITY_TRUSTSTORE_GENERATED" == "true" ]]; then
    store_secret "SECURITY-TRUSTSTORE-FILE" "$SECURITY_TRUSTSTORE_PATH"
  fi
}

resolve_session_cookie_secure() {
  local ssl_enabled lb_tls_termination

  ssl_enabled="$(ensure_boolean "${SSL_ENABLED:-false}" "false")"
  lb_tls_termination="$(ensure_boolean "${LB_TLS_TERMINATION:-false}" "false")"

  if [[ "$ssl_enabled" == "true" || "$lb_tls_termination" == "true" ]]; then
    log DEBUG "Session cookie Secure enabled (SSL_ENABLED=$ssl_enabled, LB_TLS_TERMINATION=$lb_tls_termination)"
    echo "true"
  else
    log WARN "Session cookie Secure disabled (no external TLS detected: SSL_ENABLED=$ssl_enabled, LB_TLS_TERMINATION=$lb_tls_termination)"
    echo "false"
  fi
}

detect_network_filesystem() {
  local fs_type
  fs_type=$(stat -f "${HARMONY_CONFIG}" --format "%T")
  case "$fs_type" in
    cifs*|smb*|nfs*)
      log WARN "${HARMONY_CONFIG} is on a network filesystem ($fs_type)"
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

publish_domibus_env() {
  log DEBUG "Setting environment"

  publish_env SECURITY_KEYSTORE_PATH "$SECURITY_KEYSTORE_PATH"
  publish_env SECURITY_KEYSTORE_PASSWORD "$SECURITY_KEYSTORE_PASSWORD"
  publish_env SECURITY_KEYSTORE_TYPE "$SECURITY_KEYSTORE_TYPE"

  publish_env SECURITY_TRUSTSTORE_PATH "$SECURITY_TRUSTSTORE_PATH"
  publish_env SECURITY_TRUSTSTORE_PASSWORD "$SECURITY_TRUSTSTORE_PASSWORD"
  publish_env SECURITY_TRUSTSTORE_TYPE "$SECURITY_TRUSTSTORE_TYPE"
  publish_env SECURITY_KEY_PRIVATE_PASSWORD "$SECURITY_KEY_PRIVATE_PASSWORD"

  if [ -z "$PRESERVE_BACKUP_FILE_DATE" ]; then
    PRESERVE_BACKUP_FILE_DATE=$(detect_network_filesystem && echo true || echo false)
  fi
  publish_env PRESERVE_BACKUP_FILE_DATE "$PRESERVE_BACKUP_FILE_DATE"

  if [ -z "$UI_SESSION_SECURE" ]; then
    UI_SESSION_SECURE="$(resolve_session_cookie_secure)"
  fi
  publish_env UI_SESSION_SECURE "$UI_SESSION_SECURE"

  publish_env SML_ZONE "${SML_ZONE:-}"

  publish_env USE_DYNAMIC_DISCOVERY "$USE_DYNAMIC_DISCOVERY"
}

init_domibus() {
  log DEBUG "Started"

  load_security_stores_from_secrets
  manage_security_certificates

  if is_primary; then
    store_secrets
  fi

  publish_domibus_env

  log DEBUG "Done"
}

init_domibus
