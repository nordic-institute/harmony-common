#!/command/with-contenv bash
set -euo pipefail
umask 0027

source /usr/lib/harmony-ap/lib/harmony-common
source /usr/lib/harmony-ap/lib/harmony-cluster

readonly STAGE="init-webserver"

: "${TLS_PUBLIC_CERT_NAME:=tls}"
: "${TLS_PUBLIC_CERT_PATH:=${CERT_DIR}/$TLS_PUBLIC_CERT_NAME-$CERT_ALIAS.cer}"
: "${TLS_KEYSTORE_PATH:=${HARMONY_SECURITY}/tls-keystore.p12}"
: "${TLS_KEYSTORE_B64:=}"
: "${TLS_KEYSTORE_TYPE:=pkcs12}"
: "${TLS_TRUSTSTORE_PATH:=${HARMONY_SECURITY}/tls-truststore.p12}"
: "${TLS_TRUSTSTORE_B64:=}"
: "${TLS_TRUSTSTORE_TYPE:=pkcs12}"

: "${TLS_SOCKET_PROTOCOL:=TLSv1.2}"
: "${LB_TLS_TERMINATION:=false}"

load_tls_stores_from_secrets() {
  if [ -z "$TLS_KEYSTORE_B64" ] && [ ! -f "$TLS_KEYSTORE_PATH" ]; then
    log DEBUG "Reading TLS keystore file from secret"
    read_secret "TLS-KEYSTORE-FILE" "$TLS_KEYSTORE_PATH" || true
  fi

  if [ -z "$TLS_TRUSTSTORE_B64" ] && [ ! -f "$TLS_TRUSTSTORE_PATH" ]; then
    log DEBUG "Reading TLS truststore file from secret"
    read_secret "TLS-TRUSTSTORE-FILE" "$TLS_TRUSTSTORE_PATH" || true
  fi
}

manage_tls_certificates() {
  log DEBUG "Processing TLS certificates"

  # Determine keystore and truststore current values
  local keystore_current
  keystore_current=$(read_secret "TLS-KEYSTORE-PASSWORD" || true)
  local truststore_current
  truststore_current=$(read_secret "TLS-TRUSTSTORE-PASSWORD" || true)

  TLS_FQDN="${TLS_FQDN:-$(hostname -f)}"
  TLS_DNAME="${TLS_DNAME:-CN=$TLS_FQDN}"
  TLS_SAN="${TLS_SAN:-DNS:$TLS_FQDN}"

  tls_store_output=$(
    KEYSTORE_PASSWORD="${TLS_KEYSTORE_PASSWORD:-$keystore_current}" \
    TRUSTSTORE_PASSWORD="${TLS_TRUSTSTORE_PASSWORD:-$truststore_current}" \
    harmony-store \
      --stage "$STAGE" \
      --keystore-path "$TLS_KEYSTORE_PATH" \
      --keystore-base64 "$TLS_KEYSTORE_B64" \
      --keystore-type "$TLS_KEYSTORE_TYPE" \
      --truststore-path "$TLS_TRUSTSTORE_PATH" \
      --truststore-base64 "$TLS_TRUSTSTORE_B64" \
      --truststore-type "$TLS_TRUSTSTORE_TYPE" \
      --should-add-certificate-to-truststore "true" \
      --alias "$CERT_ALIAS" \
      --public-cert-path "$TLS_PUBLIC_CERT_PATH" \
      --dname "$TLS_DNAME" \
      --san "$TLS_SAN" \
      --label "TLS"
  )

  declare -A tls_vals=()
  while IFS= read -r line; do
    [[ "$line" == *=* ]] || continue
    tls_vals["${line%%=*}"]="${line#*=}"
  done <<< "$tls_store_output"

  TLS_KEYSTORE_PASSWORD="${tls_vals[KEYSTORE_PASSWORD]}"
  TLS_KEYSTORE_GENERATED="${tls_vals[KEYSTORE_GENERATED]}"
  TLS_KEYSTORE_PASSWORD_GENERATED="${tls_vals[KEYSTORE_PASSWORD_GENERATED]}"
  TLS_TRUSTSTORE_PASSWORD="${tls_vals[TRUSTSTORE_PASSWORD]}"
  TLS_TRUSTSTORE_GENERATED="${tls_vals[TRUSTSTORE_GENERATED]}"
  TLS_TRUSTSTORE_PASSWORD_GENERATED="${tls_vals[TRUSTSTORE_PASSWORD_GENERATED]}"
}

store_secrets() {
  if [[ "$TLS_KEYSTORE_PASSWORD_GENERATED" == "true" ]]; then
    store_secret "TLS-KEYSTORE-PASSWORD" "$TLS_KEYSTORE_PASSWORD"
  fi

  if [[ "$TLS_TRUSTSTORE_PASSWORD_GENERATED" == "true" ]]; then
    store_secret "TLS-TRUSTSTORE-PASSWORD" "$TLS_TRUSTSTORE_PASSWORD"
  fi

  if [[ "$TLS_KEYSTORE_GENERATED" == "true" ]]; then
    store_secret "TLS-KEYSTORE-FILE" "$TLS_KEYSTORE_PATH"
  fi

  if [[ "$TLS_TRUSTSTORE_GENERATED" == "true" ]]; then
    store_secret "TLS-TRUSTSTORE-FILE" "$TLS_TRUSTSTORE_PATH"
  fi
}

is_non_ssl_environment() {
  [[ "$DEPLOYMENT_CLUSTERED" == "true" || "$LB_TLS_TERMINATION" == "true" ]]
}

resolve_server_config() {
  log DEBUG "Resolving server SSL and port defaults"

  if [ -z "${SSL_ENABLED:-}" ]; then
    if is_non_ssl_environment; then
      SSL_ENABLED=false
    else
      SSL_ENABLED=true
    fi
  fi

  if [ -z "${SERVER_PORT:-}" ]; then
    if is_non_ssl_environment; then
      SERVER_PORT=8080
    else
      SERVER_PORT=8443
    fi
  fi

  log INFO "Server configuration:"
  log INFO "  SSL enabled: $SSL_ENABLED"
  log INFO "  Port: $SERVER_PORT"
}

publish_webserver_env() {
  publish_env TLS_KEYSTORE_PATH "$TLS_KEYSTORE_PATH"
  publish_env TLS_KEYSTORE_PASSWORD "$TLS_KEYSTORE_PASSWORD"
  publish_env TLS_KEYSTORE_TYPE "$TLS_KEYSTORE_TYPE"

  publish_env TLS_TRUSTSTORE_PASSWORD "$TLS_TRUSTSTORE_PASSWORD"
  publish_env TLS_TRUSTSTORE_PATH "$TLS_TRUSTSTORE_PATH"
  publish_env TLS_TRUSTSTORE_TYPE "$TLS_TRUSTSTORE_TYPE"

  publish_env TLS_SOCKET_PROTOCOL "$TLS_SOCKET_PROTOCOL"
  publish_env TLS_KEY_ALIAS "$CERT_ALIAS"
  publish_env LB_TLS_TERMINATION "$LB_TLS_TERMINATION"

  publish_env SSL_ENABLED "$SSL_ENABLED"
  publish_env SERVER_PORT "$SERVER_PORT"

  if [[ "$SSL_ENABLED" == "true" ]]; then
    publish_env TOMCAT_SCHEME "https"
    publish_env TOMCAT_SECURE "true"
  else
    publish_env TOMCAT_SCHEME "http"
    publish_env TOMCAT_SECURE "false"
  fi
}

init_webserver() {
  log DEBUG "Started"

  load_tls_stores_from_secrets
  manage_tls_certificates

  if is_primary; then
    store_secrets
  fi

  resolve_server_config
  publish_webserver_env

  log DEBUG "Done"
}

init_webserver
