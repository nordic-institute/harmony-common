#!/bin/bash
set -euo pipefail

[[ -n "${__HARMONY_COMMON_INCLUDED:-}" ]] && return
readonly __HARMONY_COMMON_INCLUDED=1

log() {
  local lvl="${1:-INFO}" msg="${2:-}"; shift 2 || true
  local stg="${STAGE:-}"
  local nid="${NODE_ID:-}"

  if command -v harmony-log &>/dev/null; then
    harmony-log "$lvl" "$nid" "$stg" "$msg"
  else
    echo "[$lvl] [$nid] [$stg] $msg" >&2
  fi
}

die() {
  log ERROR "$1";
  exit 1;
}

ensure_boolean() {
  case "$1" in
    true|false) echo "$1" ;;
    *)
      log WARN "Invalid boolean value '$1', defaulting to '$2'";
      echo "$2"
      ;;
  esac
}

copy_directory_contents_if_missing() {
  local source_dir="$1" destination_dir="$2"

  if [[ ! -d "$destination_dir" ]]; then
    mkdir -p "$destination_dir"
    chmod 0750 "$destination_dir"
  fi

  local source_file destination_file tmp
  for source_file in "$source_dir"/*; do
    destination_file="$destination_dir/$(basename "$source_file")"

    if [[ ! -e "$destination_file" ]]; then
      tmp="$(mktemp "${destination_file}.tmp.XXXXXX")"

      cp -pr "$source_file" "$tmp"
      mv -n "$tmp" "$destination_file" > /dev/null 2>&1 || rm -rf "$tmp"
      chmod 600 "$destination_file"
    fi
  done
}

property_helper() {
  local quiet_flag=""
  if [[ "${!#}" == "--quiet" ]]; then
    quiet_flag="--quiet"
    set -- "${@:1:$(($#-1))}"
  fi

  harmony-property \
    --stage "$STAGE" \
    --node-id "$NODE_ID" \
    --action "$1" \
    --config-path "$APPLICATION_CONFIG_PATH_TEMP" \
    --property "$2" \
    $quiet_flag \
    ${3:+--value "$3"}
}

get_property()    { property_helper GET     "$@"; }
set_property()    { property_helper SET     "$@"; }
remove_property() { property_helper REMOVE  "$@"; }
