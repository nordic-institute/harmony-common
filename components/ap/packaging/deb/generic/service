[Unit]
Description=Harmony eDelivery Access - Access Point
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=forking
AmbientCapabilities=CAP_NET_BIND_SERVICE
TasksMax=infinity

PIDFile=/run/harmony-ap/harmony-ap.pid

Environment=CATALINA_PID=/run/harmony-ap/harmony-ap.pid
Environment=CATALINA_TMPDIR=/var/tmp
Environment=CATALINA_HOME=/usr/lib/harmony-ap/tomcat
Environment=CATALINA_BASE=/var/lib/harmony-ap/tomcat
Environment=CATALINA_OUT=/var/log/harmony-ap/catalina.out

EnvironmentFile=-/var/lib/harmony-ap/security/secrets.env

ExecStart=/usr/lib/harmony-ap/tomcat/bin/startup.sh
ExecStop=/usr/lib/harmony-ap/tomcat/bin/shutdown.sh 15

User=harmony-ap
Group=harmony-ap
UMask=0007
TimeoutStartSec=120
TimeoutStopSec=60
RestartSec=30
Restart=on-failure
SuccessExitStatus=143

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/harmony-ap /var/lib/harmony-ap /var/log/harmony-ap /usr/local/lib/harmony-ap

[Install]
WantedBy=multi-user.target
