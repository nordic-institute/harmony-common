#!/bin/bash

set -euo pipefail

readonly PACKAGE="harmony-smp"

log()  { echo "$PACKAGE: $*" >&2; }
warn() { echo "$PACKAGE: WARNING: $*" >&2; }
die()  { echo "$PACKAGE: ERROR: $*" >&2; exit 1; }

ensure_service_user() {
  if ! getent passwd harmony-smp >/dev/null; then
    adduser --system --quiet --no-create-home --shell /usr/sbin/nologin --group --gecos "Harmony user" harmony-smp
  fi

  if [[ "$(id -u harmony-smp)" -eq 0 ]]; then
    die "The Harmony SMP system user must not have uid 0 (root). Please fix it and reinstall the package."
  fi

  if [[ "$(id -g harmony-smp)" -eq 0 ]]; then
    die "The Harmony SMP system user must not have root as primary group. Please fix it and reinstall the package."
  fi
}

prepare_migration_to_230() {
  systemctl stop harmony-smp 2>/dev/null || true

  # Create a full backup of old configuration
  local backup_dir="/var/backups/harmony-smp/2.3.0"
  if [[ -d "$backup_dir" ]]; then
    local suffix=1
    while [[ -d "${backup_dir}.${suffix}" ]]; do
      (( suffix++ ))
    done
    backup_dir="${backup_dir}.${suffix}"
  fi
  install -d -m 0700 /var/backups/harmony-smp
  install -d -m 0700 "$backup_dir"

  # Back up config directory
  if [[ -d /etc/harmony-smp ]]; then
    mkdir -p "${backup_dir}/etc/harmony-smp"
    cp -rp /etc/harmony-smp/. "${backup_dir}/etc/harmony-smp/"
  fi

  # Back up setup templates
  if [[ -d /opt/harmony-smp/setup ]]; then
    mkdir -p "${backup_dir}/opt/harmony-smp/setup"
    cp -rp /opt/harmony-smp/setup/. "${backup_dir}/opt/harmony-smp/setup/"
  fi

  # Backup setenv.sh if it exists (generated by old postinst, not a conffile)
  if [[ -f /opt/harmony-smp/bin/setenv.sh ]]; then
    mkdir -p "${backup_dir}/opt/harmony-smp/bin"
    cp -p /opt/harmony-smp/bin/setenv.sh "${backup_dir}/opt/harmony-smp/bin/"
  fi

  # Backup logback.xml from inside the WAR deployment (placed by install process)
  if [[ -f /opt/harmony-smp/webapps/ROOT/WEB-INF/classes/logback.xml ]]; then
    mkdir -p "${backup_dir}/opt/harmony-smp/webapps/ROOT/WEB-INF/classes"
    cp -p /opt/harmony-smp/webapps/ROOT/WEB-INF/classes/logback.xml \
      "${backup_dir}/opt/harmony-smp/webapps/ROOT/WEB-INF/classes/"
  fi

  log "Backup created at ${backup_dir}"

  # Remove conffiles to prevent dpkg prompts during upgrade.
  #   context.xml is always modified by old postinst (xmlstarlet)
  #   tomcat-conf/* are no longer conffiles.
  rm -f /etc/harmony-smp/tomcat-conf/context.xml
  rm -f /etc/harmony-smp/tomcat-conf/logging.properties
  rm -f /etc/harmony-smp/tomcat-conf/web.xml
  rm -f /etc/harmony-smp/tomcat-conf/catalina.policy
  rm -f /etc/harmony-smp/tomcat-conf/catalina.properties
  rm -f /etc/harmony-smp/tomcat-conf/jaspic-providers.xml
  rm -f /etc/harmony-smp/tomcat-conf/jaspic-providers.xsd
  rm -f /etc/harmony-smp/tomcat-conf/tomcat-users.xml
  rm -f /etc/harmony-smp/tomcat-conf/tomcat-users.xsd
  rm -f /etc/harmony-smp/smp-log4j.properties

  # Remove old symlink created by the old package's links file
  rm -f /opt/harmony-smp/conf

  # Save migration marker for postinst
  install -d -m 0750 -o root -g harmony-smp /var/lib/harmony-smp
  echo "$backup_dir" > /var/lib/harmony-smp/.migration-2.3.0-backup-path
}

case "${1:-}" in
  install)
    ensure_service_user
    ;;

  upgrade)
    ensure_service_user

    if dpkg --compare-versions "$2" lt "2.3.0"; then
      prepare_migration_to_230
    fi
    ;;

  abort-upgrade)
    ;;

  *)
    die "preinst called with unknown argument '${1:-}'"
    ;;
esac
