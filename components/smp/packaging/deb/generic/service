[Unit]
Description=Harmony eDelivery Access - SMP
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=forking
AmbientCapabilities=CAP_NET_BIND_SERVICE
TasksMax=infinity

PIDFile=/run/harmony-smp/harmony-smp.pid

Environment=CATALINA_PID=/run/harmony-smp/harmony-smp.pid
Environment=CATALINA_TMPDIR=/var/tmp
Environment=CATALINA_HOME=/usr/lib/harmony-smp/tomcat
Environment=CATALINA_BASE=/var/lib/harmony-smp/tomcat
Environment=CATALINA_OUT=/var/log/harmony-smp/catalina.out

EnvironmentFile=-/var/lib/harmony-smp/security/secrets.env

ExecStart=/usr/lib/harmony-smp/tomcat/bin/startup.sh
ExecStop=/usr/lib/harmony-smp/tomcat/bin/shutdown.sh 15

User=harmony-smp
Group=harmony-smp
UMask=0007
TimeoutStartSec=120
TimeoutStopSec=60
RestartSec=30
Restart=on-failure
SuccessExitStatus=143

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/harmony-smp /var/lib/harmony-smp /var/log/harmony-smp

[Install]
WantedBy=multi-user.target
