#!/bin/bash
. /usr/share/debconf/confmodule

set -euo pipefail

SUCCESS=false
DROPDBONERROR=false

HARMONY_HOME="/opt/harmony-smp"
HARMONY_BASE="/etc/harmony-smp"

SERVER_XML="${HARMONY_BASE}/tomcat-conf/server.xml"
SET_ENV="${HARMONY_HOME}/bin/setenv.sh"

log() { echo "harmony-smp: $*" >&2; }
warn() { log "WARNING: $*"; }
error() { log "ERROR: $*"; }

# shellcheck disable=SC2317
cleanup() {
  db_stop
  if [ ! "$SUCCESS" = true ]; then
    error "Installation failed"
    if [[ "$DROPDBONERROR" = true && "$DB_HOST" = localhost ]]; then
      mysql -e "DROP SCHEMA $DB_SCHEMA; DROP USER $DB_USER@localhost"
    fi
  fi
}
trap cleanup EXIT

case "$1" in
 configure)

  db_get harmony-smp/serverdn
  SERVERDN="$RET"
  db_get harmony-smp/integratewithsml
  INTEGRATESML="$RET"
  if [ ! "$INTEGRATESML" = true ]; then
    INTEGRATESML=false
  fi
  db_get harmony-smp/smlurl
  SMLURL="$RET"
  db_get harmony-smp/smpurl
  SMPURL="$RET"
  db_get harmony-smp/smpip
  SMPIP="$RET"
  db_get harmony-smp/tomcatport
  TOMCATPORT="$RET"

  db_get harmony-smp/jdbc-url || true
  JDBC_URL="${RET:-jdbc:mysql://localhost:3306/harmony_smp}"
  db_get harmony-smp/database-schema || true
  DB_SCHEMA="${RET:-harmony_smp}"
  db_get harmony-smp/database-user || true
  DB_USER="${RET:-harmony_smp}"
  db_get harmony-smp/database-password || true
  DB_PASSWORD="${RET}"
  db_get harmony-smp/database-host || true
  DB_HOST="${RET:-localhost}"

  AUSER=""
  HASHEDPASSWORD=""
  HOST_FQDN="$(hostname -f 2>/dev/null || hostname)"

  backup_file() {
    local file="$1"

    local timestamp
    timestamp="$(date +%Y%m%d%H%M%S)"

    local backup="${file}.bak.${timestamp}"
    cp -a "$file" "$backup"

    echo "$backup"
  }

  normalize_dname() {
    local dname="$1"

    if [[ -z "${dname// }" ]]; then
      echo "CN=$HOST_FQDN"
      return
    fi

    if [[ "$dname" != *"="* ]]; then
      echo "CN=$dname"
      return
    fi

    echo "$dname"
  }

  gen_keypair() {
    local alias="$1"
    local keystore="$2"
    local storepass="$3"
    local keypass="$4"
    local dname="$5"

    keypair_run_keytool() {
      local dn="$1"
      keytool -genkeypair -keyalg RSA -alias "$alias" \
        -keystore "$keystore" -storetype PKCS12 -storepass "$storepass" \
        -keypass "$keypass" -validity 333 -keysize 3072 -dname "$dn" 2>/dev/null
    }

    if ! keypair_run_keytool "$dname"; then
      warn "Invalid server DN '$dname'. Falling back to CN=$HOST_FQDN"
      keypair_run_keytool "CN=$HOST_FQDN"
    fi
  }

  if [[ "$DB_HOST" = localhost ]]; then
    SCHEMA_EXISTS=$(mysql -s -N -e "SELECT SCHEMA_NAME FROM INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME='$DB_SCHEMA'");

    if [ -z "$SCHEMA_EXISTS" ]; then
      echo "Creating database schema $DB_SCHEMA" >&2

      DB_PASSWORD=${DB_PASSWORD:-$(openssl rand -base64 12)}

      mysql -e \
        "create schema $DB_SCHEMA; \
        alter schema $DB_SCHEMA charset=utf8mb4 collate=utf8mb4_bin; \
        create user if not exists $DB_USER@localhost; \
        alter user $DB_USER@localhost identified by '$DB_PASSWORD'; \
        grant all on $DB_SCHEMA.* to $DB_USER@localhost;" 1>&2

      DROPDBONERROR=true
    fi
  fi

  echo "Apply Liquibase migrations"  >&2

  if [[ -z $DB_USER || -z $DB_PASSWORD ]]; then
    echo 'Existing database credentials not found' >&2
    exit 1
  fi

  db_get harmony-smp/adminuser
  AUSER="$RET"
  db_get harmony-smp/adminpassword
  APASSWORD="$RET"
  HASHEDPASSWORD=$(java -cp "/opt/harmony-smp/webapps/ROOT/WEB-INF/lib/*" \
    eu.europa.ec.edelivery.smp.utils.BCryptPasswordHash "$APASSWORD")

  env -i \
    LIQUIBASE_COMMAND_URL="$JDBC_URL" \
    LIQUIBASE_COMMAND_USERNAME="$DB_USER" \
    LIQUIBASE_COMMAND_PASSWORD="${DB_PASSWORD//\\/\\\\}" \
    LIQUIBASE_COMMAND_DRIVER="com.mysql.cj.jdbc.Driver" \
    LIQUIBASE_CLASSPATH="/opt/harmony-smp/lib/mysql-connector-j.jar" \
    LIQUIBASE_ANALYTICS_ENABLED=false \
    LIQUIBASE_SHOW_BANNER=false \
    LIQUIBASE_SQL_SHOW_SQL_WARNINGS=false \
    "/opt/harmony-smp/liquibase/liquibase" \
      --changelog-file=/opt/harmony-smp/db/db.changelog.xml \
      update \
      -DadminUser="$AUSER" \
      -DadminPassword="$HASHEDPASSWORD" \
      2>&1 | sed 's/^/    /' >&2

  mkdir -p /etc/harmony-smp/tomcat-conf
  mkdir -p /var/opt/harmony-smp/work
  mkdir -p /var/opt/harmony-smp/temp
  mkdir -p /run/harmony-smp
  mkdir -p /var/tmp/harmony-smp

  if [ ! -f "$SERVER_XML" ]; then
    cp /opt/harmony-smp/setup/context.xml.template /etc/harmony-smp/tomcat-conf/

    for config_file in web.xml catalina.properties logging.properties; do
      if [[ -f /opt/harmony-smp/setup/tomcat-defaults/$config_file ]]; then
        cp /opt/harmony-smp/setup/tomcat-defaults/$config_file /etc/harmony-smp/tomcat-conf/$config_file
        chmod 640 /etc/harmony-smp/tomcat-conf/$config_file
      fi
    done

    rm -f /etc/harmony-smp/*.p12

    SERVERDN="$(normalize_dname "$SERVERDN")"

    KEYSTOREPASS=$(openssl rand -base64 12)
    gen_keypair "selfsigned" "/etc/harmony-smp/smp-keystore.p12" "$KEYSTOREPASS" "$KEYSTOREPASS" "$SERVERDN"

    TRUSTSTOREPASS=$(openssl rand -base64 12)
    keytool -genkeypair -keyalg RSA -alias mock \
      -keystore /etc/harmony-smp/smp-truststore.p12 -storetype PKCS12 -storepass "$TRUSTSTOREPASS" \
      -keypass "$TRUSTSTOREPASS" -dname "CN=mock" 2>/dev/null
    keytool -delete -alias mock \
      -keystore /etc/harmony-smp/smp-truststore.p12 -storepass "$TRUSTSTOREPASS" 2>/dev/null

    TLSKEYPASS=$(openssl rand -base64 12)
    gen_keypair "selfsigned" "/etc/harmony-smp/tls-keystore.p12" "$TLSKEYPASS" "$TLSKEYPASS" "$SERVERDN"

    TLSTRUSTSTOREPASS=$(openssl rand -base64 12)
    keytool -export -alias selfsigned -file /etc/harmony-smp/selfsigned.cer \
        -keystore /etc/harmony-smp/tls-keystore.p12 -storepass "$TLSKEYPASS" 2>/dev/null
    keytool -import -noprompt -alias selfsigned -file /etc/harmony-smp/selfsigned.cer \
        -keystore /etc/harmony-smp/tls-truststore.p12 -storepass "$TLSTRUSTSTOREPASS" 2>/dev/null
    rm -f /etc/harmony-smp/selfsigned.cer

    env -i \
      tls_keystore_password="$TLSKEYPASS" \
      tls_truststore_password="$TLSTRUSTSTOREPASS" \
      tomcat_port="$TOMCATPORT" \
      envsubst </opt/harmony-smp/setup/server.xml.template >$SERVER_XML

    env -i dbuser="$DB_USER" dbpassword="$DB_PASSWORD" jdbcurl="$JDBC_URL" \
      envsubst </opt/harmony-smp/setup/context.xml.template >/etc/harmony-smp/tomcat-conf/context.xml

    env -i \
      tls_truststore_password="$TLSTRUSTSTOREPASS" \
      envsubst '$tls_truststore_password' </opt/harmony-smp/setup/setenv.sh.template >$SET_ENV

    chmod +x $SET_ENV

    cat >/etc/harmony-smp/smp.init.properties <<EOF
# Initial configuration

smp.keystore.filename=smp-keystore.p12
smp.keystore.password={DEC}{$KEYSTOREPASS}
smp.keystore.type=PKCS12

smp.truststore.filename=smp-truststore.p12
smp.truststore.password={DEC}{$TRUSTSTOREPASS}
smp.truststore.type=PKCS12

contextPath.output=true

bdmsl.integration.enabled=$INTEGRATESML
EOF

    if [[ $INTEGRATESML = "true" ]]; then
      cat >>/etc/harmony-smp/smp.init.properties <<EOF
bdmsl.integration.url=$SMLURL
bdmsl.integration.tls.disableCNCheck=false
bdmsl.integration.logical.address=$SMPURL
bdmsl.integration.physical.address=$SMPIP
bdmsl.integration.tls.serverSubjectRegex=
EOF
    fi
  else
    if dpkg --compare-versions "$2" lt "2.3.0"; then
      backup="$(backup_file "$SERVER_XML")"
      tmp="$(mktemp)"

      log "Migrating server.xml Tomcat 9 format to Tomcat 10 (backup: $backup)"

      fail_restore() {
        warn "$1 Restoring backup."
        cp -a "$backup" "$SERVER_XML" || true
        rm -f "$tmp" || true
        return 1
      }

      XSL_221_TO_230="/opt/harmony-smp/tomcat/migrations/221-to-230-sslhostconfig-and-host.xsl"
      if ! xmlstarlet tr "$XSL_221_TO_230" "$SERVER_XML" >"$tmp"; then
        fail_restore "XSLT transform failed."
      else
        xmlstarlet fo "$tmp" >"$tmp.fmt" && mv -f "$tmp.fmt" "$tmp" || true
      fi

      if ! xmlstarlet val "$tmp" >/dev/null; then
        fail_restore "XML validation failed after migration."
      fi

      if ! cp -f "$tmp" "$SERVER_XML"; then
        fail_restore "Failed to write migrated $SERVER_XML."
      fi

      rm -f "$tmp" || true
      log "Migration applied successfully"
    fi

    xmlstarlet edit --pf --inplace \
      --update "/Context/Resource/@username" --value "$DB_USER" \
      --update "/Context/Resource/@password" --value "$DB_PASSWORD" \
      --update "/Context/Resource/@url" --value "$JDBC_URL" \
      /etc/harmony-smp/tomcat-conf/context.xml

    xmlstarlet edit --pf --inplace \
      --update '(//Connector[@SSLEnabled="true"]/@port)[1]' --value "$TOMCATPORT" \
      $SERVER_XML
  fi

  HARMONY_HOME=${HARMONY_HOME:-/opt/harmony-smp}
  if [[ ! -f /etc/harmony-smp/smp.config.properties ]]; then
    if [[ -f ${HARMONY_HOME}/setup/smp.config.properties.template ]]; then
      cp ${HARMONY_HOME}/setup/smp.config.properties.template /etc/harmony-smp/smp.config.properties
      chmod 640 /etc/harmony-smp/smp.config.properties
      log "Created /etc/harmony-smp/smp.config.properties from template"
    fi
  fi

  DROPDBONERROR=false
  db_reset harmony-smp/adminpassword
  db_reset harmony-smp/database-password
  DB_PASSWORD=

  if dpkg --compare-versions "$2" lt-nl "2.3.0"; then
    sed -i -E '\|^export CLASSPATH=/etc/harmony-smp.*|d' $SET_ENV || true
    JAVA_HOME_PATH=$(update-java-alternatives -l | grep -m1 java-1.21 | head -n 1 | tr -s " " | cut -d " " -f 3) || true

    if [[ -z "${JAVA_HOME_PATH:-}" ]] && command -v java >/dev/null 2>&1; then
      JAVA_HOME_PATH="$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")"
    fi

    if [[ -n "${JAVA_HOME_PATH:-}" ]]; then
      if grep -q '^export JAVA_HOME=' $SET_ENV; then
        sed -i -E "s|^export JAVA_HOME=.*|export JAVA_HOME=\"$JAVA_HOME_PATH\"|" $SET_ENV
      else
        echo "export JAVA_HOME=\"$JAVA_HOME_PATH\"" >>$SET_ENV
      fi
    else
      warn "Java 21 not found. JAVA_HOME not updated"
    fi
  fi

  # Make sure the administrative user exists
  if ! getent passwd harmony-smp > /dev/null; then
    adduser --system --quiet --no-create-home --shell /usr/sbin/nologin --group --gecos "Harmony user" harmony-smp
  fi

  # check validity of user and group
  if [ "$(id -u harmony-smp)" -eq 0 ]; then
    echo "The Harmony SMP system user 'harmony-smp' must not have uid 0 (root).Please fix this and reinstall this package." >&2
    exit 1
  fi
  if [ "$(id -g harmony-smp)" -eq 0 ]; then
    echo "The Harmony SMP system user 'harmony-smp' must not have root as primary group. Please fix this and reinstall this package." >&2
    exit 1
  fi

  mkdir -p /opt/harmony-smp/temp

  chown -R harmony-smp:harmony-smp /opt/harmony-smp
  chmod -R u=Xrw,g=Xr,o=X /opt/harmony-smp

  chown -R harmony-smp:harmony-smp /var/opt/harmony-smp
  chmod -R u=Xrw,g=Xr,o=X /var/opt/harmony-smp

  chown -R harmony-smp:harmony-smp /run/harmony-smp
  chmod 0750 /run/harmony-smp

  chown -R harmony-smp:harmony-smp /var/tmp/harmony-smp
  chmod 0750 /var/tmp/harmony-smp

  # nicer log directory permissions
  mkdir -p /var/log/harmony-smp
  chmod 1770 /var/log/harmony-smp
  chown harmony-smp:adm /var/log/harmony-smp

  # config folder permissions
  chown -R harmony-smp:harmony-smp /etc/harmony-smp
  chmod -R u=Xrw,g=Xr,o=X /etc/harmony-smp

  systemctl daemon-reload || warn "systemctl daemon-reload failed"

  if [ "$(systemctl is-enabled harmony-smp)" = "enabled" ]; then
    systemctl start harmony-smp
  fi

  SUCCESS=true
 ;;

 abort-upgrade|abort-remove|abort-deconfigure)
 ;;

 *)
    log "postinst called with unknown argument \`$1'" >&2
    exit 1
 ;;
esac

exit 0
