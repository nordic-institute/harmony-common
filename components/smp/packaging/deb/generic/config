#!/bin/bash

set -eo pipefail

# Source confmodule before `set -u`. debconf in Jammy is not nounset-safe
# https://salsa.debian.org/pkg-debconf/debconf/-/merge_requests/12
. /usr/share/debconf/confmodule

set -u
trap 'db_stop 2>/dev/null || true' EXIT

readonly PACKAGE="harmony-smp"
readonly SECURITY_DIR="/var/lib/${PACKAGE}/security"
readonly SECRETS_FILE="${SECURITY_DIR}/secrets.env"

die() {
  echo "${PACKAGE}: ERROR: $1" >&2
  exit 1
}

check_state_file() {
  [[ -f "${SECURITY_DIR}/$1" ]]
}

# =============================================================================
# Drop-in and secrets readers (duplicated from harmony-deb)
#
# The config script runs before package files are unpacked on fresh install,
# so it cannot source harmony-deb. Keep these functions in sync.
# =============================================================================

readonly DROPIN_DEFAULTS_DIR="/usr/lib/systemd/system/${PACKAGE}.service.d"
readonly DROPIN_CONFIGS_DIR="/etc/systemd/system/${PACKAGE}.service.d"

# Keep in sync with harmony-deb:_read_dropin_value
_read_dropin_value() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 0
  grep -Po "^Environment=\"?${key}=\K[^\"]*" "$file" 2>/dev/null | tail -1 || true
}

# Keep in sync with harmony-deb:get_dropin
get_dropin() {
  local key="$1"

  local -A by_name=()
  local dir file name
  for dir in "$DROPIN_DEFAULTS_DIR" "$DROPIN_CONFIGS_DIR"; do
    [[ -d "$dir" ]] || continue
    for file in "$dir"/*.conf; do
      [[ -f "$file" ]] || continue
      name="${file##*/}"
      by_name["$name"]="$file"
    done
  done

  (( ${#by_name[@]} > 0 )) || return 0

  local value="" sorted_key v
  while IFS= read -r sorted_key; do
    v="$(_read_dropin_value "${by_name[$sorted_key]}" "$key")"
    [[ -z "$v" ]] || value="$v"
  done < <(printf '%s\n' "${!by_name[@]}" | sort)

  printf '%s' "$value"
}

# Keep in sync with harmony-deb:get_secret
get_secret() {
  local key="$1"

  [[ -f "$SECRETS_FILE" ]] || return 0

  local value
  value="$(grep -m1 -Po "^${key}=\K.*$" "$SECRETS_FILE" 2>/dev/null || true)"

  if [[ "$value" == \"*\" ]]; then
    value="${value#\"}"
    value="${value%\"}"
    # Unescape in reverse order ($ and " first, backslash last)
    value="${value//\\\$/\$}"     # \$ → $
    value="${value//\\\"/\"}"     # \" → "
    value="${value//\\\\/\\}"     # \\ → \
  fi

  printf '%s' "$value"
}

# --- End duplicated functions ---

prompt_debconf_value() {
  local template="$1" dropin_var="$2" initial="${3:-}"

  local existing
  existing="$(get_dropin "$dropin_var")"

  if [[ -n "$existing" ]]; then
    db_set "$template" "$existing"
  elif [[ -n "$initial" ]]; then
    db_get "$template"
    [[ -n "$RET" ]] || db_set "$template" "$initial"
  fi

  [[ "$is_upgrade" == true && -n "$existing" ]] && return 0

  db_input high "$template" || true
}

require_debconf_value() {
  local template="$1" label="$2"

  db_get "$template"
  [[ -n "$RET" ]] || die "${label} is required. Run 'dpkg-reconfigure harmony-smp' to retry."
}

require_debconf_number() {
  local template="$1" label="$2"

  require_debconf_value "$template" "$label"
  [[ "$RET" =~ ^[0-9]+$ ]] || die "${label} must be a number, got: '${RET}'. Run 'dpkg-reconfigure harmony-smp' to retry."
}

needs_keystore() {
  local template="$1" file_prefix="$2"

  if [[ "$is_reconf" == true ]]; then
    db_get "$template"
    [[ "$RET" == true ]] && return 0
  fi

  ! check_state_file "${file_prefix}.p12" && ! check_state_file "${file_prefix}.jks"
}

configure_debconf() {
  local action="$1" old_version="${2:-}"

  local is_fresh=false
  local is_upgrade=false
  local is_reconf=false

  if [[ "$action" == "reconfigure" ]]; then
    is_reconf=true
  elif [[ -z "$old_version" ]]; then
    is_fresh=true
  else
    is_upgrade=true
  fi

  # Pre-2.3.0 upgrade: skip prompts. All configuration values will be
  # extracted from the old config files by the migration script in postinst.
  if [[ "$is_upgrade" == true ]] && dpkg --compare-versions "$old_version" lt "2.3.0"; then
    return 0
  fi

  if [[ "$is_reconf" == true ]]; then
    db_title "Harmony SMP - Reconfiguration"
    db_input high harmony-smp/reconfigure-notice || true
    db_go

    db_title "Harmony SMP - Certificate Rotation"
    db_input high harmony-smp/rotate_tls_keystore || true
    db_input high harmony-smp/rotate_signing_keystore || true
    db_go
  fi

  if [[ "$is_fresh" == true ]]; then
    db_title "Harmony SMP - Administrator"
    db_beginblock
    db_input high harmony-smp/adminuser || true
    db_input high harmony-smp/adminpassword || true
    db_endblock
    db_go

    require_debconf_value harmony-smp/adminuser "Administrator username"

    # SML integration (fresh install only, DB is authoritative afterward)
    db_title "Harmony SMP - SML Integration"
    db_input high harmony-smp/integratewithsml || true
    db_go

    db_get harmony-smp/integratewithsml
    if [[ "${RET:-false}" == true ]]; then
      db_beginblock
      db_input high harmony-smp/smlurl || true
      db_input high harmony-smp/smpurl || true
      db_input high harmony-smp/smpip || true
      db_endblock
      db_go
    fi
  fi

  # Certificates
  db_title "Harmony SMP - Certificates"

  local needs_tls=false needs_signing=false
  needs_keystore harmony-smp/rotate_tls_keystore tls-keystore && needs_tls=true
  needs_keystore harmony-smp/rotate_signing_keystore smp-keystore && needs_signing=true

  if [[ "$needs_tls" == true || "$needs_signing" == true ]]; then
    local fqdn
    fqdn="$(hostname -f 2>/dev/null || hostname)"
    prompt_debconf_value harmony-smp/serverdn SERVER_DN "CN=$fqdn"

    if [[ "$needs_tls" == true ]]; then
      prompt_debconf_value harmony-smp/serversan TLS_SERVER_SAN "DNS:$fqdn"
    fi
    db_go

    require_debconf_value harmony-smp/serverdn "Server certificate DN"
    if [[ "$needs_tls" == true ]]; then
      require_debconf_value harmony-smp/serversan "TLS certificate SAN"
    fi
  fi

  # Network
  db_title "Harmony SMP - Network"
  prompt_debconf_value harmony-smp/tomcatport TOMCAT_PORT
  db_go

  require_debconf_number harmony-smp/tomcatport "Tomcat port"

  # Database
  db_title "Harmony SMP - Database"
  prompt_debconf_value harmony-smp/database-host SMP_DATABASE_SERVERNAME
  db_go

  require_debconf_value harmony-smp/database-host "Database host"
  db_get harmony-smp/database-host

  # Remote database
  if [[ "$RET" != "localhost" ]]; then
    db_beginblock
    prompt_debconf_value harmony-smp/database-port SMP_DATABASE_PORT
    prompt_debconf_value harmony-smp/database-schema SMP_DATABASE_SCHEMA
    db_endblock
    db_go

    require_debconf_number harmony-smp/database-port "Database port"
    require_debconf_value harmony-smp/database-schema "Database schema"
    db_get harmony-smp/database-schema
    local db_schema="$RET"

    db_subst harmony-smp/database-user db_schema "$db_schema"
    db_beginblock
    prompt_debconf_value harmony-smp/database-user SMP_JDBC_USER

    if [[ "$is_upgrade" != true ]] || [[ -z "$(get_secret SMP_JDBC_PASSWORD)" ]]; then
      db_input high harmony-smp/database-password || true
    fi
    db_endblock
    db_go

    require_debconf_value harmony-smp/database-user "Database user"
  fi
}

case "${1:-}" in
  configure|reconfigure)
    configure_debconf "$1" "${2:-}"
    ;;

  *)
    die "config called with unknown argument '${1:-}'"
    ;;
esac
