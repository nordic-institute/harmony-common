<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <Resource
        name="jdbc/harmony-smp"
        auth="Container"
        type="javax.sql.DataSource"
        maxTotal="100"
        maxIdle="30"
        maxWaitMillis="10000"
        username="${SMP_JDBC_USER}"
        password="${SMP_JDBC_PASSWORD}"
        driverClassName="${SMP_JDBC_DRIVER}"
        url="${SMP_JDBC_URL}"
    />
    <Manager pathname="" />
</Context>
